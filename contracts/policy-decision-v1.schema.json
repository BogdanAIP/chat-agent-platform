{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "policy-decision-v1.schema.json",
  "title": "Policy decision v1",
  "type": "object",
  "required": ["decision_id", "capability", "effective_risk", "enforced_by", "reasons"],
  "properties": {
    "decision_id": {"type": "string", "pattern": "^pol_[a-f0-9]+$"},
    "capability": {"type": "string", "minLength": 1},
    "effective_risk": {"enum": ["allow", "guarded", "deny"]},
    "enforced_by": {"type": "string", "minLength": 1},
    "reasons": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}

