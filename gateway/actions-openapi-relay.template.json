{
  "openapi": "3.1.0",
  "info": {
    "title": "Agent Platform Local Relay",
    "version": "1.0.0",
    "description": "Calls only the two Stage 4 allowlisted operations through the user's explicitly enabled local agent-platform relay."
  },
  "servers": [
    {
      "url": "__RELAY_URL__"
    }
  ],
  "paths": {
    "/": {
      "post": {
        "operationId": "runLocalAgentTool",
        "summary": "Run an allowlisted local agent operation",
        "description": "Use local_ping to verify the local Windows agent, or runtime_self_test to run the policy-gated local runtime health test. The local relay must be explicitly switched on.",
        "security": [
          {
            "mcpToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "action"
                ],
                "properties": {
                  "action": {
                    "type": "string",
                    "enum": [
                      "local_ping",
                      "runtime_self_test"
                    ]
                  },
                  "message": {
                    "type": "string",
                    "maxLength": 1024,
                    "description": "Optional only for local_ping. Omit for runtime_self_test."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Local execution result or a structured local/availability error.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "success",
                        "error"
                      ]
                    },
                    "result": {
                      "type": "object",
                      "additionalProperties": true
                    },
                    "error": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "X-MCP-Token API key is missing or invalid."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "mcpToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-MCP-Token"
      }
    }
  }
}
