{
  "$schema": "https://docs.1mcp.app/schemas/v1.0.0/mcp-config.json",
  "mcpServers": {
    "filesystem": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem@0.6.3",
        "${CHAT_LOCAL_FILES_ROOT}"
      ],
      "tags": ["candidate", "filesystem", "read-only", "free"],
      "disabledTools": [
        "create_directory",
        "write_file",
        "edit_file",
        "move_file"
      ],
      "connectionTimeout": 30000,
      "requestTimeout": 30000
    }
  }
}
