{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tool-v1.schema.json",
  "title": "Tool result v1",
  "type": "object",
  "required": ["request_id", "status", "result", "artifact_refs", "provenance", "policy_decision_id", "error"],
  "properties": {
    "request_id": {"type": "string", "pattern": "^req_"},
    "status": {"enum": ["success", "error"]},
    "result": {"type": "object"},
    "artifact_refs": {"type": "array"},
    "provenance": {"type": "object"},
    "policy_decision_id": {"type": "string", "pattern": "^pol_"},
    "error": {"type": ["object", "null"]}
  },
  "additionalProperties": false
}
