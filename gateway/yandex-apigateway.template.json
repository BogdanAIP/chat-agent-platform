{
  "openapi": "3.0.0",
  "info": {
    "title": "Agent Platform Relay Gateway",
    "version": "1.0.0"
  },
  "paths": {
    "/": {
      "get": {
        "responses": {
          "200": {
            "description": "Relay health response"
          }
        },
        "x-yc-apigateway-integration": {
          "type": "cloud_functions",
          "function_id": "__FUNCTION_ID__",
          "payload_format_version": "0.1"
        }
      },
      "post": {
        "responses": {
          "200": {
            "description": "Relay operation response"
          }
        },
        "x-yc-apigateway-integration": {
          "type": "cloud_functions",
          "function_id": "__FUNCTION_ID__",
          "payload_format_version": "0.1"
        }
      }
    },
    "/gpt": {
      "post": {
        "parameters": [
          {
            "name": "X-MCP-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "GPT Action relay operation response"
          }
        },
        "x-yc-apigateway-integration": {
          "type": "http",
          "url": "https://functions.yandexcloud.net/__FUNCTION_ID__",
          "method": "POST",
          "headers": {
            "Content-Type": "application/json",
            "X-MCP-Token": "{X-MCP-Token}"
          },
          "omitEmptyHeaders": true,
          "timeouts": {
            "connect": 5,
            "read": 70
          }
        }
      }
    }
  }
}
