{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "secret-ref-v1.schema.json",
  "title": "Secret reference v1",
  "type": "object",
  "required": ["contract_version", "secret_ref", "allowed_consumers"],
  "properties": {
    "contract_version": {"const": "secret-ref-v1"},
    "secret_ref": {"type": "string", "pattern": "^secret://[a-z0-9._/-]+$"},
    "allowed_consumers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}, "contains": {"type": "string"}}
  },
  "additionalProperties": false
}

