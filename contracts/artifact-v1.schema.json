{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "artifact-v1.schema.json",
  "title": "Artifact v1",
  "type": "object",
  "required": ["artifact_id", "type", "path", "mime", "size_bytes", "sha256", "created_by", "created_at", "status", "data_class", "metadata", "external_policy"],
  "properties": {
    "artifact_id": {"type": "string", "pattern": "^art_"},
    "type": {"type": "string"},
    "path": {"type": "string"},
    "mime": {"type": "string"},
    "size_bytes": {"type": "integer", "minimum": 0},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "created_by": {"type": "string"},
    "created_at": {"type": "string"},
    "status": {"enum": ["ready", "invalid"]},
    "data_class": {"enum": ["public", "project", "private", "sensitive"]},
    "metadata": {"type": "object"},
    "external_policy": {
      "type": "object",
      "required": ["staging_allowed", "allowed_executors"],
      "properties": {
        "staging_allowed": {"type": "boolean"},
        "allowed_executors": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
