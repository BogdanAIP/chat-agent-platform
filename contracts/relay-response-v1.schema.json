{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "relay-response-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "request_id", "status", "result", "error"],
  "properties": {
    "contract_version": {"const": "relay-response-v1"},
    "request_id": {"type": "string", "pattern": "^rly_[a-f0-9]{32}$"},
    "status": {"enum": ["success", "error"]},
    "result": {},
    "error": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "retryable", "safe_to_retry"],
          "properties": {
            "code": {"type": "string", "minLength": 1},
            "message": {"type": "string", "minLength": 1},
            "retryable": {"type": "boolean"},
            "safe_to_retry": {"type": "boolean"}
          }
        }
      ]
    }
  }
}
